{
  "name": "@relay/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "db:migrate": "tsx scripts/db.ts up",
    "db:rollback": "tsx scripts/db.ts down",
    "db:rollback:all": "tsx scripts/db.ts down all",
    "db:status": "tsx scripts/db.ts status",
    "db:seed": "tsx scripts/seed.ts",
    "db:check": "tsx scripts/db-check.ts",
    "test": "vitest run",
    "sim": "tsx scripts/simulate-riders.ts",
    "demo:order": "tsx scripts/demo-order.ts"
  },
  "dependencies": {
    "@relay/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.8.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.1.0"
  }
}
