# API
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Local Docker database (docker compose up db). For Neon, use its pooled and direct URLs.
DATABASE_URL=postgresql://relay:relay_dev_password@localhost:5432/relay
DIRECT_URL=postgresql://relay:relay_dev_password@localhost:5432/relay
# Generate each with: openssl rand -hex 32 (they must be different, 32+ characters)
JWT_SECRET=
JWT_REFRESH_SECRET=
# Paystack TEST keys only (Dashboard > Settings > API Keys). Outside production the API refuses anything but sk_test_...
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
RESEND_API_KEY=
DELIVERY_BASE_FEE_KOBO=50000
DELIVERY_PER_KM_KOBO=15000
DELIVERY_MIN_FEE_KOBO=80000

# Web
# Dispatcher (all optional; these are the defaults)
# DISPATCH_ENABLED=true          set to false to stop automatic offers (admin assigns by hand)
# DISPATCH_OFFER_SECONDS=30      how long a rider has to answer an offer
# DISPATCH_RETRY_SECONDS=20      wait before trying again when no rider is available
# DISPATCH_MAX_ROUNDS=3          failed rounds before an admin is alerted
# DISPATCH_MAX_PICKUP_KM=15      riders further than this from the vendor are never offered the order
# DISPATCH_RIDER_STALE_SECONDS=120   riders not seen for this long count as offline
# DISPATCH_TICK_MS=2000          how often the background loop runs

NEXT_PUBLIC_API_URL=http://localhost:4000
